/* TODO key w/o perso (6args)
*/

u64[8] IV = {
  0x6a09e667f3bcc908,
  0xbb67ae8584caa73b,
  0x3c6ef372fe94f82b,
  0xa54ff53a5f1d36f1,
  0x510e527fade682d1,
  0x9b05688c2b3e6c1f,
  0x1f83d9abfb41bd6b,
  0x5be0cd19137e2179
};

u64[12] SIGMA = {
  0xFEDCBA9876543210,
  0x357B20C16DF984AE,
  0x491763EADF250C8B,
  0x8F04A562EBCD1397,
  0xD386CB1EFA427509,
  0x91EF57D438B0A6C2,
  0xB8293670A4DEF15C,
  0xA2684F05931CE7BD,
  0x5A417D2C803B9EF6,
  0x0DC3E9BF5167482A,
  0xFEDCBA9876543210,
  0x357B20C16DF984AE
};

inline
fn sigma(reg u64 i, inline int j) -> reg u64 {
  reg ptr u64[12] psigma = SIGMA;
  reg u64 res;
  res = psigma[i];
  res >>= j << 2;
  res &= 0xF;
  return res;
}

inline
fn init(
  reg ptr u64[8] h,
  reg ptr u64[2] t f
) -> stack u64[16] {

reg u64 tmp;
stack u64[16] v;
inline int i;

for i = 0 to 8 {
  tmp = h[i];
  v[i] = tmp;
}
for i = 8 to 12 {
  tmp = IV[i - 8];
  v[i] = tmp;
}
for i = 12 to 14 {
  tmp = IV[i - 8];
  tmp ^= t[i - 12];
  v[i] = tmp;
}
for i = 14 to 16 {
  tmp = IV[i - 8];
  tmp ^= f[i - 14];
  v[i] = tmp;
}

return v;
}

inline
fn G(
  reg u64 r,
  inline int i,
  reg u64 a b c d,
  reg ptr u64[16] m
) -> reg u64, reg u64, reg u64, reg u64 {

reg u64 j;

j = sigma(r, 2 * i);
a += b;
a += m[j];

d ^= a;
d >>r = 32;

c += d;

b ^= c;
b >>r = 24;

j = sigma(r, 2 * i + 1);
a += b;
a += m[j];

d ^= a;
d >>r = 16;

c += d;

b ^= c;
b >>r = 63;

return a, b, c, d;
}

fn compress(
  reg ptr u64[8] h,
  reg ptr u64[16] m,
  reg ptr u64[2] t f
) -> reg ptr u64[8] {

stack u64[16] v;
reg u64 r a b c d tmp;
inline int i;

v = init(h, t, f);

?{}, r = #set0();
while (r < 12) {
  for i = 0 to 4 {
    a = v[0 + i];
    b = v[4 + i];
    c = v[8 + i];
    d = v[12 + i];
    a, b, c, d = G(r, i, a, b, c, d, m);
    v[0 + i] = a;
    v[4 + i] = b;
    v[8 + i] = c;
    v[12 + i] = d;
  }
  for i = 0 to 4 {
    a = v[0 + i];
    b = v[4 + ((i + 1) % 4)];
    c = v[8 + ((i + 2) % 4)];
    d = v[12 + ((i + 3) % 4)];
    a, b, c, d = G(r, 4 + i, a, b, c, d, m);
    v[0 + i] = a;
    v[4 + ((i + 1) % 4)] = b;
    v[8 + ((i + 2) % 4)] = c;
    v[12 + ((i + 3) % 4)] = d;
  }
  r += 1;
}

for i = 0 to 8 {
  tmp = v[i];
  tmp ^= v[i + 8];
  h[i] ^= tmp;
}

return h;
}

fn jasmin_blake2b(
  reg ptr u64[8] params,
  reg u64 data length
) -> reg ptr u64[8] {
inline int i;
reg bool c;
stack u64[16] block;
stack u64[4] tf;
reg ptr u64[2] t f;
t = tf[0:2];
f = tf[2:2];

for i = 0 to 8  {
  reg u64 iv = IV[i];
  params[i] ^= iv;
}

reg ptr u64[16] m = block;

reg u64 zero;
?{}, zero = #set0();

t[0] = zero;
t[1] = zero;
f[0] = zero;
f[1] = zero;

while (length >= 128) {

for i = 0 to 16 {
  m[i] = (u64)[data + 8 * i];
}

params = compress(params, m, t, f);
c, t[0] += 128;
_, t[1] += zero + c;
length -= 128;
data += 128;
}

// Last block

reg u64 idx = 16;
#[bounded]
while (idx > 0) {
  idx -= 1;
  m[idx] = zero;
}

while (idx < length) {
  m[u8 idx] = (u8)[data + idx];
  idx += 1;
}

c, t[0] += length;
_, t[1] += zero + c;
f[0] = 0xffffffffffffffff;

params = compress(params, m, t, f);

return params;
}

export
fn blake2b(
  reg u64 hash hashlen,
  reg ptr u8[16] perso,
  reg u64 data length
) -> reg u64 {
reg u64 zero;
inline int i;
stack u64[8] state;
reg ptr u64[8] pstate;

state[0] = 0x01010000;
state[0] ^= hashlen;
?{}, zero = #set0();
for i = 1 to 6 {
  state[i] = zero;
}
for i = 6 to 8 {
  state[i] = perso[u64 i - 6];
}

pstate = state;
pstate = jasmin_blake2b(pstate, data, length);

reg u64 n;
n = hashlen;
if n <= 64 {
 while (n > 0) {
  n -= 1;
  (u8)[hash + n] = pstate[u8 n];
 }
} else {
 n = -1;
}

return n;
}
