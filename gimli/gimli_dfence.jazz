param int N_ROUND = 24;
param int N_COLUMN = 4;
param int ROUND_CONSTANT = 0x9e377900;

inline
fn swap(reg ptr u32[12] state, inline int i, inline int j) -> reg ptr u32[12] {
    reg u32 x y;

    x = state[i];
    y = state[j];
    state[i] = y;
    state[j] = x;

    return state;
}

inline fn rol32(reg u32 src, inline u32 rot) -> reg u32 {

    reg u32 tmp = 32 - rot;
    reg u32 dst;

    dst = src << rot;
    tmp = #SRL(src, tmp);

    dst = dst | tmp;

    return dst;
}

export
fn gimli(reg ptr u32[12] state) -> reg ptr u32[12] {
    inline int round, column;
    reg u32 x, y, z;
    reg u32 a, b;
    reg u32 rc;

    state = #dfence_ptr(state);

    rc = ROUND_CONSTANT;

    for round = N_ROUND downto 0 {
    for column = 0 to N_COLUMN {
    x = state[0 + column];
    // x <<r= 24;
    x = rol32(x, 24);
    y = state[4 + column];
    // y <<r= 9;
    y = rol32(y, 9);
    z = state[8 + column];

    reg u32 tmp = (z << 1);
    a = x ^ tmp;
    b = y & z;
    tmp = b << 2;
    a ^= tmp;
    state[8 + column] = a;

    a = y ^ x;
    b = x | z;
    tmp = b << 1;
    a ^= tmp;
    state[4 + column] = a;

    a = z ^ y;
    b = x & y;
    tmp = b << 1;
    a ^= tmp;
    state[0 + column] = a;
    }

    if (round % 4 == 0) {
    state = swap(state, 0, 1);
    state = swap(state, 2, 3);
    }

    if (round % 4 == 2) {
    state = swap(state, 0, 2);
    state = swap(state, 1, 3);
    }

    if (round % 4 == 0) {
    a = state[0];
    b = rc + round;
    a ^= b;
    state[0] = a;
    }
    }
    return state;
}
